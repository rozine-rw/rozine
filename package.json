{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "npm@10.9.8",
    "engines": {
        "node": "24.15.0"
    },
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "format": "vp fmt resources/ tests/web/ scripts/quality/ vitest.config.ts tsconfig.test.json",
        "format:check": "vp fmt --check resources/ tests/web/ scripts/quality/ vitest.config.ts tsconfig.test.json",
        "lint": "vp lint . --fix",
        "lint:check": "vp lint .",
        "types:check": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.test.json",
        "test:web": "vp test run --config vitest.config.ts",
        "test:web:watch": "vp test watch --config vitest.config.ts",
        "test:web:coverage:prepare": "node scripts/quality/verify-client-coverage.mjs --prepare",
        "test:web:coverage:collect": "vp test run --config vitest.config.ts --coverage",
        "test:web:coverage:verify": "node scripts/quality/verify-client-coverage.mjs",
        "test:web:coverage": "npm run test:web:coverage:prepare && npm run test:web:coverage:collect && npm run test:web:coverage:verify",
        "i18n:check": "node scripts/quality/verify-i18n.mjs",
        "generated:check": "node scripts/quality/verify-generated-client.mjs",
        "ci:web:foundation": "npm run lint:check && npm run format:check && npm run types:check && npm run i18n:check && npm run test:web && npm run build && npm run generated:check",
        "ci:web": "npm run lint:check && npm run format:check && npm run types:check && npm run i18n:check && npm run test:web:coverage && npm run build && npm run generated:check",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.6",
        "@types/node": "^22.13.5",
        "@vitest/coverage-v8": "4.1.11",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint-plugin-jest-dom": "5.10.1",
        "eslint-plugin-testing-library": "7.16.2",
        "jsdom": "30.0.1",
        "vite-plus": "0.3.0",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vitest": "4.1.11"
    }
}
