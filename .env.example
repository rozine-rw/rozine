APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Non-live isolation (separate deployment, never a URL/query-string switch).
# APP_ENV=staging or uat requires PostgreSQL with BOTH DB_DATABASE and
# DB_USERNAME set to rozine_uat, DB_URL empty, APP_DEBUG=false and an HTTPS URL.
# APP_ENV=demo requires PostgreSQL database/user rozine_demo, or SQLite at the
# absolute path <app-root>/database/isolated/rozine_demo.sqlite (no symlinks).
# Create that disposable SQLite file only in a separate demo checkout.
# Demo/UAT must have no provider/cloud/SMTP credentials. Cache, sessions, views,
# storage and logs use storage/isolated; database queues use a profile namespace;
# remote drivers, real email and unfaked Laravel HTTP-client calls are disabled.
# Raw SDK/cURL egress also requires the separately provisioned network policy.
# An existing public/storage link must target storage/isolated/<demo|uat>/public.
# Provision a dedicated least-privilege DB role, filesystem permissions and
# outbound network policy separately; configuration checks do not certify IAM.
# UAT and production always reject db:seed and destructive migration commands.
ROZINE_DEMO_ENABLED=false
ROZINE_DEMO_RESET_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rozine
DB_USERNAME=rozine
DB_PASSWORD=
DB_URL=

# PostgreSQL test databases.
#
# Both phpunit.xml and phpunit.pgsql.xml use PostgreSQL and include concurrency
# tests. Provision rozine_test owned by the non-superuser role rozine_test,
# and rozine_demo owned by rozine_demo for disposable demo-fixture tests.
# Each database must deny PUBLIC access; test roles must not access rozine.
# Local loopback trust authentication accepts the test defaults. Password-based
# test servers use rozine_test and rozine_demo as disposable test passwords.
# Never point these roles or the test host/port at a live server.
#
# On an empty disposable PostgreSQL server, provision all three databases with:
#   psql -v ON_ERROR_STOP=1 -f .github/scripts/prepare-test-databases.sql
# Then run php artisan migrate and composer test:php:pgsql. Keep these test
# database settings out of the application's DB_DATABASE/DB_USERNAME values.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
