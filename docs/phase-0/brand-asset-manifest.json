{
  "schemaVersion": 1,
  "status": "DERIVED FROM INSPECTION 2026-09-07 - AWAITING BRAND OWNER CONFIRMATION",
  "purpose": "Maps the 31 non-semantic Figma exports to what each one actually depicts, so a brand decision can name an artwork instead of a filename. Identity hashes for the same files are also recorded in brand-source-manifest.json; this file adds meaning, not provenance.",
  "method": "Colours read from element fills with export artefacts removed; artworks grouped by identical path geometry ignoring colour; depictions confirmed by viewing the matching PNG renders.",
  "findings": {
    "distinctArtworks": 8,
    "totalFiles": 31,
    "markIsAStar": "Confirmed by inspection. The approved V1.0 brand system describes the mark as the wing, and the live runtime asset is still rozine-wing-white.png. Every frame in this package uses a five-pointed star with a swept lower-left tail. The guide's wing language describes the previous mark.",
    "crimsonIsNotADesignColour": "#BA0D3B appears 48 times across 18 frames and every occurrence is <circle r=\"0.5\"> on canvases 2796-7545 units wide - roughly one fifteen-thousandth of the width. It is invisible at any rendered size and carries no design meaning. It is Figma export residue, not a brand colour.",
    "packageColoursDifferFromGuide": "The package uses #0039FF, #1D9E75 and #C2661F where the approved system specifies #0A5CFF, #12A150 and #DD8A00.",
    "competingPrimaryLockups": "Two lockups exist in full colourway sets: detached leading star, and star integrated at the i. Only one can be the primary."
  },
